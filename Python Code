        self.root.geometry("900x720")
        self.root.minsize(840, 680)
        self.root.configure(bg=CORES_TIAO["fundo"])

        self.fila_ui = queue.Queue()
        self.serial = None
        self.serial_lock = threading.Lock()

        self.estado = "menu"
        self.ultimo_aviso_estado = {}

        self.sintoma_vars = {}
        self.sintomas_selecionados = []
        self.numero_atendimento = self.proximo_numero_atendimento()

        self.atendimento_ativo = False
        self.status_texto = tk.StringVar(value="Sistema iniciado.")

        self.conectar_serial()
        self.tela_menu()

        self.root.after(200, self.processar_fila_ui)
        self.root.after(1000, self.repetir_voz_por_estado)

    # ========================================================
    # SERIAL
    # ========================================================

    def conectar_serial(self):
        if MODO_SIMULADO:
            print("[INFO] Modo simulado ativo. Arduino não será conectado.")
            return

        try:
            self.serial = serial.Serial(PORTA_COM, BAUD_RATE, timeout=1)
            time.sleep(2)
            print(f"[OK] Conectado ao Arduino na porta {PORTA_COM}")

            thread = threading.Thread(target=self.loop_serial, daemon=True)
            thread.start()

        except serial.SerialException as erro:
            print("[ERRO SERIAL]", erro)
            falar(FRASES["ERRO_SERIAL"])
            messagebox.showwarning(
                "Serial",
                f"Não foi possível conectar ao Arduino em {PORTA_COM}.\n\n"
                "Verifique a porta COM ou use MODO_SIMULADO = True."
            )

    def loop_serial(self):
        while True:
            try:
                linha = self.serial.readline().decode("utf-8", errors="ignore").strip()

                if linha:
                    self.fila_ui.put(("serial", linha))

            except Exception as erro:
                self.fila_ui.put(("erro_serial", str(erro)))
                break

    def enviar_para_arduino(self, texto):
        if MODO_SIMULADO:
            print("[SIMULADO PYTHON → ARDUINO]", texto.strip())
            return

        if self.serial is None:
            return

        try:
            with self.serial_lock:
                self.serial.write(texto.encode("utf-8"))
                print("[PYTHON → ARDUINO]", texto.strip())
        except Exception as erro:
            print("[ERRO ENVIO SERIAL]", erro)

