def preparar_csv():
    if not os.path.exists(ARQUIVO_CSV):
        with open(ARQUIVO_CSV, "w", newline="", encoding="utf-8") as arquivo:
            writer = csv.writer(arquivo, delimiter=";")
            writer.writerow([
                "numero_atendimento",
                "data_hora",
                "sintomas_selecionados",
                "risco_sintomas",
                "temperatura",
                "bpm",
                "spo2",
                "risco_sensores",
                "risco_final",
                "observacao"
            ])


def salvar_ficha(numero, sintomas, risco_sintomas, temp, bpm, spo2, risco_sensores, risco_final):
    preparar_csv()

    data_hora = datetime.now().strftime("%d/%m/%Y %H:%M:%S")

    with open(ARQUIVO_CSV, "a", newline="", encoding="utf-8") as arquivo:
        writer = csv.writer(arquivo, delimiter=";")
        writer.writerow([
            numero,
            data_hora,
            ", ".join(sintomas) if sintomas else "Nenhum",
            risco_sintomas,
            f"{temp:.2f}" if temp is not None else "indisponível",
            bpm if bpm is not None else "indisponível",
            spo2 if spo2 is not None else "indisponível",
            risco_sensores if risco_sensores != "IGNORAR" else "indisponível",
            risco_final,
            "Protótipo acadêmico. Não representa diagnóstico médico."
        ])

    salvar_ficha_txt(
        numero,
        data_hora,
        sintomas,
        risco_sintomas,
        temp,
        bpm,
        spo2,
        risco_sensores,
        risco_final
    )


def salvar_ficha_txt(numero, data_hora, sintomas, risco_sintomas, temp, bpm, spo2, risco_sensores, risco_final):
    texto_sintomas = ", ".join(sintomas) if sintomas else "Nenhum"
    texto_risco_sensores = risco_sensores if risco_sensores != "IGNORAR" else "indisponível"

    linhas = [
        "=" * 48,
        f"FICHA DE ESPERA - T.I.A.O.",
        f"Número de espera: {numero}",
        f"Data e hora: {data_hora}",
        "",
        "Dados do paciente/atendimento:",
        f"Sintomas selecionados: {texto_sintomas}",
        f"Risco pelos sintomas: {risco_sintomas}",
        f"Temperatura: {formatar_float(temp, ' °C')}",
        f"BPM: {formatar_valor(bpm)}",
        f"SpO2: {formatar_valor(spo2, '%')}",
        f"Risco dos sensores: {texto_risco_sensores}",
        f"Classificação final: {risco_final}",
        "",
        "Observação: protótipo acadêmico. Não representa diagnóstico médico.",
        "=" * 48,
        "",
    ]

    with open(ARQUIVO_FICHAS_TXT, "a", encoding="utf-8") as arquivo:
        arquivo.write("\n".join(linhas))


