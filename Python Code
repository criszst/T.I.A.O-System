def converter_float(valor):
    """
    Converte TEMP para float.
    Se vier N/A, -1, vazio ou inválido, retorna None.
    """
    if valor is None:
        return None

    valor = str(valor).strip()

    if valor.upper() == "N/A":
        return None

    try:
        numero = float(valor)

        if numero < 0:
            return None

        return numero

    except Exception:
        return None


def converter_int(valor):
    """
    Converte BPM, SpO2 e PRESENCA para int.
    Se vier N/A, -1, vazio ou inválido, retorna None.
    """
    if valor is None:
        return None

    valor = str(valor).strip()

    if valor.upper() == "N/A":
        return None

    try:
        numero = int(float(valor))

        if numero < 0:
            return None

        return numero

    except Exception:
        return None


def formatar_valor(valor, sufixo=""):
    """
    Mostra valores indisponíveis de forma bonita.
    """
    if valor is None:
        return "indisponível"

    return f"{valor}{sufixo}"


def formatar_float(valor, sufixo=""):
    if valor is None:
        return "indisponível"

    return f"{valor:.1f}{sufixo}"


