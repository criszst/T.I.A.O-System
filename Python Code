    def mudar_estado(self, novo_estado, fala_inicial=None):
        self.estado = novo_estado
        self.ultimo_aviso_estado[novo_estado] = time.time()

        if fala_inicial:
            falar(fala_inicial)

    def criar_frame(self, parent=None, bg=None, **kwargs):
        return tk.Frame(parent or self.root, bg=bg or CORES_TIAO["fundo"], **kwargs)

    def criar_label(self, parent, fg=None, bg=None, **kwargs):
        kwargs.setdefault("fg", fg or CORES_TIAO["grafite"])
        kwargs.setdefault("bg", bg or CORES_TIAO["fundo"])
        return tk.Label(parent, **kwargs)

    def criar_botao(self, parent, text, command, cor=None, **kwargs):
        cor_fundo = cor or CORES_TIAO["azul"]
        kwargs.setdefault("font", ("Arial", 13, "bold"))
        kwargs.setdefault("fg", CORES_TIAO["branco"])
        kwargs.setdefault("bg", cor_fundo)
        kwargs.setdefault("activeforeground", CORES_TIAO["branco"])
        kwargs.setdefault("activebackground", cor_fundo)
        kwargs.setdefault("relief", "flat")
        kwargs.setdefault("bd", 0)
        kwargs.setdefault("padx", 10)
        kwargs.setdefault("pady", 7)
        kwargs.setdefault("cursor", "hand2")
        return tk.Button(parent, text=text, command=command, **kwargs)

