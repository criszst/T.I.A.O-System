# ============================================================
# VOZ EM THREAD
# ============================================================

fila_voz = queue.Queue()


def worker_voz():
    engine = pyttsx3.init()
    engine.setProperty("rate", 145)
    engine.setProperty("volume", 1.0)

    try:
        vozes = engine.getProperty("voices")
        for voz in vozes:
            nome = voz.name.lower()
            if "portuguese" in nome or "brazil" in nome:
                engine.setProperty("voice", voz.id)
                break
    except Exception:
        pass

    while True:
        texto = fila_voz.get()

        if texto is None:
            break

        try:
            print("[VOZ]", texto)
            engine.say(texto)
            engine.runAndWait()
        except Exception as erro:
            print("[ERRO VOZ]", erro)


threading.Thread(target=worker_voz, daemon=True).start()


def falar(texto):
    fila_voz.put(texto)


