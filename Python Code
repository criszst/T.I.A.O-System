            font=("Arial", 22, "bold"),
            fg=CORES_TIAO["azul"]
        ).pack(pady=15)

        filtro_var = tk.StringVar(value="TODOS")

        filtro_frame = self.criar_frame(self.root)
        filtro_frame.pack(pady=5)

        self.criar_label(filtro_frame, text="Filtro:", font=("Arial", 11, "bold")).grid(row=0, column=0, padx=5)

        combo = ttk.Combobox(
            filtro_frame,
            textvariable=filtro_var,
            values=["TODOS", "VERDE", "AMARELO", "VERMELHO"],
            state="readonly",
            width=15
        )
        combo.grid(row=0, column=1, padx=5)

        texto = tk.Text(
            self.root,
            width=110,
            height=22,
            bg=CORES_TIAO["branco"],
            fg=CORES_TIAO["grafite"],
            insertbackground=CORES_TIAO["azul"],
            relief="solid",
            bd=1
        )
        texto.pack(pady=10)

        def carregar():
            texto.delete("1.0", tk.END)

            if not os.path.exists(ARQUIVO_CSV):
                texto.insert(tk.END, "Nenhuma ficha salva ainda.")
                return

            filtro = filtro_var.get()

            with open(ARQUIVO_CSV, "r", encoding="utf-8") as arquivo:
                linhas = arquivo.readlines()

            if not linhas:
                texto.insert(tk.END, "Arquivo CSV vazio.")
                return

            texto.insert(tk.END, linhas[0])
            texto.insert(tk.END, "-" * 130 + "\n")

            for linha in linhas[1:]:
                if filtro == "TODOS" or f";{filtro};" in linha:
                    texto.insert(tk.END, linha)

        botoes = self.criar_frame(self.root)
        botoes.pack(pady=10)

        self.criar_botao(
            botoes,
            text="Atualizar",
            command=carregar,
            cor=CORES_TIAO["azul"],
            width=15
        ).grid(row=0, column=0, padx=10)

        self.criar_botao(
            botoes,
            text="Voltar",
            command=self.tela_menu,
            cor=CORES_TIAO["cinza"],
            width=15
        ).grid(row=0, column=1, padx=10)

        carregar()
        self.mostrar_rodape_cores()

    # ========================================================
    # PROCESSAMENTO SERIAL
    # ========================================================

    def processar_fila_ui(self):
        while not self.fila_ui.empty():
            tipo, conteudo = self.fila_ui.get()

            if tipo == "serial":
                self.processar_linha_serial(conteudo)

            elif tipo == "erro_serial":
                print("[ERRO SERIAL]", conteudo)
                falar(FRASES["ERRO_SERIAL"])

        self.root.after(200, self.processar_fila_ui)

    def processar_linha_serial(self, linha):
        print("[ARDUINO]", linha)

        dados = interpretar_linha(linha)

        if linha.startswith("EVENT:"):
            self.processar_evento(linha)
            return

        if linha.startswith("STATUS:"):
            self.processar_status(linha, dados)
            return

        if self.eh_linha_final(dados):
            self.processar_dados_finais(dados)
            return

    def processar_evento(self, linha):
        if not self.atendimento_ativo:
            return

        if linha == "EVENT:PACIENTE_DETECTADO":
            self.mudar_estado("confirmando_presenca", FRASES["PRESENCA"])
            self.status_texto.set("Paciente detectado. Fique parado para confirmar presença.")

        elif linha == "EVENT:PRESENCA_PERDIDA":
            self.mudar_estado("aguardando_robo", "Presença perdida. Aproxime-se novamente do sensor frontal.")
            self.status_texto.set("Presença perdida. Aproxime-se novamente.")

        elif linha == "EVENT:MEDICAO_INICIADA":
            self.mudar_estado("medindo", FRASES["MEDICAO"])
            falar(FRASES["OXIMETRIA"])
            self.status_texto.set("Medição iniciada. Mantenha-se parado.")

        elif linha == "EVENT:MEDICAO_FINALIZADA":
            self.mudar_estado("aguardando_resultado", FRASES["RESULTADO"])
            self.status_texto.set("Medição finalizada. Calculando resultado.")

        elif linha == "EVENT:RESULTADO_RECEBIDO":
            print("[INFO] Arduino recebeu o resultado.")

        elif linha == "EVENT:CICLO_REINICIADO":
            falar(FRASES["REINICIANDO"])

    def processar_status(self, linha, dados):
        if not self.atendimento_ativo:
            return

        if linha.startswith("STATUS:AGUARDANDO"):
            distancia = dados.get("DIST", "---")
            self.status_texto.set(f"Aguardando paciente. Distância: {distancia} cm.")

        elif linha.startswith("STATUS:CONFIRMANDO"):
            tempo_ms = converter_int(dados.get("TEMPO")) or 0
            segundos = min(TEMPO_CONFIRMACAO_PRESENCA_SEGUNDOS, tempo_ms // 1000)
            self.status_texto.set(
                f"Confirmando presença: {segundos}/{TEMPO_CONFIRMACAO_PRESENCA_SEGUNDOS} segundos."
            )

        elif linha.startswith("STATUS:MEDINDO"):
            tempo = dados.get("TEMPO", "0")

            temp = converter_float(dados.get("TEMP"))
            bpm = converter_int(dados.get("BPM"))
            spo2 = converter_int(dados.get("SPO2"))

            self.status_texto.set(
                f"Medição em andamento: {tempo}/22 segundos\n"
                f"Temperatura: {formatar_float(temp, ' °C')}\n"
                f"BPM: {formatar_valor(bpm)}\n"
                f"SpO2: {formatar_valor(spo2, '%')}"
            )

    def eh_linha_final(self, dados):
        return (
            "PRESENCA" in dados
            and (
                "TEMP" in dados
                or "BPM" in dados
                or "SPO2" in dados
            )
        )

    def processar_dados_finais(self, dados):
        if not self.atendimento_ativo:
            return

        try:
            presenca = converter_int(dados.get("PRESENCA"))

            if presenca != 1:
                return

            temp = converter_float(dados.get("TEMP"))
            bpm = converter_int(dados.get("BPM"))
            spo2 = converter_int(dados.get("SPO2"))

            risco_sintomas = classificar_sintomas(self.sintomas_selecionados)

            c_temp = classificar_temperatura(temp)
            c_bpm = classificar_bpm(bpm)
            c_spo2 = classificar_spo2(spo2)

            risco_sensores = combinar_riscos([c_temp, c_bpm, c_spo2])

            if risco_sensores == "IGNORAR":
                risco_final = risco_sintomas
            else:
                risco_final = combinar_riscos([risco_sintomas, risco_sensores])

            if risco_final == "IGNORAR":
                risco_final = "VERDE"

            self.enviar_para_arduino(f"RISCO:{risco_final}\n")

            ficha = {
                "numero": self.numero_atendimento,
                "sintomas": self.sintomas_selecionados,
                "risco_sintomas": risco_sintomas,
                "temp": temp,
                "bpm": bpm,
                "spo2": spo2,
                "risco_sensores": risco_sensores,
                "risco_final": risco_final,
            }

            salvar_ficha(
                self.numero_atendimento,
                self.sintomas_selecionados,
                risco_sintomas,
                temp,
                bpm,
                spo2,
                risco_sensores,
                risco_final
            )

            falar(mensagem_resultado(
                risco_final,
                self.sintomas_selecionados,
                temp,
                bpm,
                spo2
            ))

            self.numero_atendimento += 1
            self.atendimento_ativo = False
            self.tela_resultado(ficha)

        except Exception as erro:
            print("[ERRO DADOS]", erro)
            falar(FRASES["ERRO_DADOS"])
            self.enviar_para_arduino("RISCO:ERRO\n")

    # ========================================================
    # VOZ REPETIDA
    # ========================================================

    def repetir_voz_por_estado(self):
        agora = time.time()

        if self.estado in INTERVALOS_VOZ:
            intervalo = INTERVALOS_VOZ[self.estado]
            ultimo = self.ultimo_aviso_estado.get(self.estado, 0)

            if agora - ultimo >= intervalo:
                self.ultimo_aviso_estado[self.estado] = agora

                if self.estado == "menu":
                    falar(FRASES["MENU"])

                elif self.estado == "confirmacao_sintomas":
                    falar(FRASES["SINTOMAS_CONFIRMADOS"])

                elif self.estado == "aguardando_robo":
                    falar(FRASES["AGUARDANDO"])

                elif self.estado == "confirmando_presenca":
                    falar(FRASES["CONFIRMANDO"])

                elif self.estado == "medindo":
                    falar(FRASES["MEDINDO"])

                elif self.estado == "aguardando_resultado":
                    falar(FRASES["RESULTADO"])

        self.root.after(1000, self.repetir_voz_por_estado)

    # ========================================================
    # SIMULAÇÃO
    # ========================================================

    def iniciar_simulacao(self):
        if not MODO_SIMULADO:
            return

        thread = threading.Thread(target=self.simular_fluxo, daemon=True)
        thread.start()

    def simular_fluxo(self):
        linhas = [
            "EVENT:PACIENTE_DETECTADO",
            "STATUS:CONFIRMANDO;DIST:45;TEMPO:2000",
            "STATUS:CONFIRMANDO;DIST:44;TEMPO:5000",
            "EVENT:MEDICAO_INICIADA",
            "STATUS:MEDINDO;TEMPO:5;TEMP:36.7;BPM:80;SPO2:98",
            "STATUS:MEDINDO;TEMPO:10;TEMP:36.8;BPM:82;SPO2:98",
            "STATUS:MEDINDO;TEMPO:15;TEMP:36.8;BPM:83;SPO2:97",
            "STATUS:MEDINDO;TEMPO:22;TEMP:36.9;BPM:82;SPO2:98",
            "EVENT:MEDICAO_FINALIZADA",
            "TEMP:36.8;BPM:82;SPO2:98;PRESENCA:1",
        ]

        for linha in linhas:
            time.sleep(2)
            self.fila_ui.put(("serial", linha))

    # ========================================================
    # UTILITÁRIOS
    # ========================================================

    def proximo_numero_atendimento(self):
        if not os.path.exists(ARQUIVO_CSV):
            return 1

        try:
            with open(ARQUIVO_CSV, "r", encoding="utf-8") as arquivo:
                linhas = arquivo.readlines()

            return max(1, len(linhas))
        except Exception:
            return 1

    def fechar(self):
        try:
            if self.serial:
                self.serial.close()
        except Exception:
            pass

        fila_voz.put(None)
        self.root.destroy()


