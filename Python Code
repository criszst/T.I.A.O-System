def classificar_sintomas(sintomas):
    if any(s in SINTOMAS_CRITICOS for s in sintomas):
        return "VERMELHO"

    if any(s in SINTOMAS_MODERADOS for s in sintomas):
        return "AMARELO"

    return "VERDE"


def classificar_temperatura(temp):
    if temp is None:
        return "IGNORAR"

    if temp < 35.0:
        return "IGNORAR"
    elif temp <= 37.4:
        return "VERDE"
    elif temp <= 38.5:
        return "AMARELO"
    else:
        return "VERMELHO"


def classificar_bpm(bpm):
    if bpm is None:
        return "IGNORAR"

    if bpm < 40:
        return "VERMELHO"
    elif bpm < 50:
        return "AMARELO"
    elif bpm <= 100:
        return "VERDE"
    elif bpm <= 120:
        return "AMARELO"
    else:
        return "VERMELHO"


def classificar_spo2(spo2):
    if spo2 is None:
        return "IGNORAR"

    if spo2 >= 95:
        return "VERDE"
    elif spo2 >= 92:
        return "AMARELO"
    else:
        return "VERMELHO"


def combinar_riscos(riscos):
    riscos_validos = [r for r in riscos if r != "IGNORAR"]

    if not riscos_validos:
        return "IGNORAR"

    if "VERMELHO" in riscos_validos:
        return "VERMELHO"

    if "AMARELO" in riscos_validos:
        return "AMARELO"

    return "VERDE"


def mensagem_resultado(risco, sintomas, temp, bpm, spo2):
    partes = []

    if risco == "VERDE":
        partes.append(FRASES["VERDE"])
    elif risco == "AMARELO":
        partes.append(FRASES["AMARELO"])
    elif risco == "VERMELHO":
        partes.append(FRASES["VERMELHO"])
    else:
        partes.append("Não foi possível classificar o atendimento.")

    if sintomas:
        partes.append("Sintomas informados: " + ", ".join(sintomas) + ".")

    if temp is not None:
        partes.append(f"Temperatura registrada de {temp:.1f} graus.")
    else:
        partes.append("Temperatura indisponível.")

    if bpm is not None:
        partes.append(f"Batimentos registrados de {bpm} batimentos por minuto.")
    else:
        partes.append("Batimentos indisponíveis.")

    if spo2 is not None:
        partes.append(f"Oxigenação estimada de {spo2} por cento.")
    else:
        partes.append("Oxigenação indisponível.")

    partes.append("Este resultado é apenas uma simulação acadêmica, não é diagnóstico médico.")

    return " ".join(partes)


